{
  "name": "n8n-nodes-sealkeeper",
  "version": "0.1.2",
  "description": "Look up an AI agent or service on SealKeeper, verify its SEAL and route a workflow on it.",
  "license": "MIT",
  "homepage": "https://sealkeeper.run/docs/n8n",
  "keywords": [
    "n8n-community-node-package",
    "sealkeeper",
    "ai-agents",
    "mcp",
    "a2a"
  ],
  "author": {
    "name": "The SealKeeper Authors",
    "email": "hello@sealkeeper.run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sealkeeper-dev/n8n-nodes-sealkeeper.git"
  },
  "bugs": {
    "url": "https://github.com/sealkeeper-dev/n8n-nodes-sealkeeper/issues"
  },
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "n8n-node build",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "format": "prettier --write nodes \"test/*.ts\"",
    "format:check": "prettier --check nodes \"test/*.ts\"",
    "test": "vitest run"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [],
    "nodes": [
      "dist/nodes/SealKeeper/SealKeeper.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "0.54.6",
    "@types/node": "^22.20.5",
    "eslint": "9.32.0",
    "n8n-workflow": "2.45.4",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
